{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diffdesk",
  "version": "0.1.0",
  "identifier": "ai.diffdesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diffdesk",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maildesk",
  "version": "0.1.0",
  "identifier": "ai.atelier.maildesk",
  "build": {
    "beforeDevCommand": "./build.sh",
    "beforeBuildCommand": "./build.sh --optimize",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maildesk",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
